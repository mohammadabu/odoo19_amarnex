<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Enhanced email template matching reference file structure -->
        <record id="email_template_file_send" model="mail.template">
            <field name="name">Document Attachment: Send by Email</field>
            <field name="model_id" ref="base.model_ir_attachment"/>
            <field name="subject">{{ object.name }}</field>
            <field name="email_from">{{ object.company_id.email }}</field>
            <field name="partner_to"></field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="xml">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hello,<br/><br/>
                        Please find the attached document for your reference.
                        <br/><br/>
                        <strong>Document Details:</strong><br/>
                        <ul style="margin-top: 8px;">
                            <li>Name: <strong><t t-out="object.name or ''"/></strong></li>
                            <t t-if="object.reference_code and object.reference_code != 'New'">
                                <li>Reference: <strong><t t-out="object.reference_code or ''"/></strong></li>
                            </t>
                            <t t-if="object.revision_number > 0">
                                <li>Revision: <strong><t t-out="object.revision_number or ''"/></strong></li>
                            </t>
                            <t t-if="object.directory_id">
                                <li>Directory: <strong><t t-out="object.directory_id.name or ''"/></strong></li>
                            </t>
                        </ul>
                        <br/>
                        Do not hesitate to contact us if you have any questions.
                        <br/><br/>
                        Best regards,
                        <t t-if="not is_html_empty(user.signature)">
                            <br/><br/>
                            <t t-out="user.signature or ''">--<br/>{{ user.name }}</t>
                        </t>
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>
